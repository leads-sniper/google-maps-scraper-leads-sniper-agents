{
  "openapi": "3.0.0",
  "info": {
    "title": "Leads Sniper Local API",
    "version": "1.0.0",
    "description": "Local REST API system for controlling the Leads Sniper Google Maps Scraper Chrome Extension."
  },
  "servers": [{"url": "http://127.0.0.1:8787", "description": "Default Local API Host"}],
  "components": {
    "securitySchemes": {
      "BearerAuth": {"type": "http", "scheme": "bearer", "description": "Your Local API key generated by the Leads Sniper Chrome Extension."}
    }
  },
  "security": [{"BearerAuth": []}],
  "paths": {
    "/v1/status": {
      "get": {
        "summary": "Get System Status",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {"type": "string", "example": "online"},
                    "extension_connected": {"type": "boolean", "example": true},
                    "active_jobs": {"type": "integer", "example": 0},
                    "queued_jobs": {"type": "integer", "example": 0}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/google-maps/search": {
      "post": {
        "summary": "Start Google Maps Scrape",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["keyword"],
                "properties": {
                  "keyword": {"type": "string", "description": "Search term or comma-separated keywords"},
                  "location": {"type": "string", "description": "Target area"},
                  "limit": {"type": "integer", "description": "Max results (default: 100)"},
                  "extract_emails": {"type": "boolean", "description": "Extract emails & social profiles"},
                  "webhook_url": {"type": "string", "description": "URL to POST results on completion"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job_id": {"type": "string", "example": "job_1783097172616_5681"},
                    "status": {"type": "string", "example": "queued"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs/{job_id}": {
      "get": {
        "summary": "Check Job Status",
        "parameters": [{"name": "job_id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job_id": {"type": "string"},
                    "status": {"type": "string", "description": "queued, running, completed, stopped, failed"},
                    "progress": {"type": "integer", "description": "Progress % relative to limit"},
                    "total_found": {"type": "integer"},
                    "limit": {"type": "integer", "description": "Requested limit"},
                    "error": {"type": "string", "description": "Warning if scroll stuck or end of results"},
                    "message": {"type": "string", "description": "Diagnostic if extension offline"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs/{job_id}/results": {
      "get": {
        "summary": "Get Results (JSON)",
        "parameters": [{"name": "job_id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job_id": {"type": "string"},
                    "status": {"type": "string"},
                    "total": {"type": "integer"},
                    "results": {"type": "array", "items": {"type": "object"}}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs/{job_id}/export.csv": {
      "get": {
        "summary": "Export CSV",
        "parameters": [{"name": "job_id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {
          "200": {
            "content": {"text/csv": {"schema": {"type": "string"}}}
          }
        }
      }
    },
    "/v1/jobs/{job_id}/stop": {
      "post": {
        "summary": "Stop Job",
        "parameters": [{"name": "job_id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job_id": {"type": "string"},
                    "status": {"type": "string", "example": "stopped"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/rotate-key": {
      "post": {
        "summary": "Rotate API Key",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["new_key"],
                "properties": {
                  "old_key": {"type": "string"},
                  "new_key": {"type": "string"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {"type": "boolean", "example": true},
                    "message": {"type": "string", "example": "API Key rotated successfully."}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/logs": {
      "get": {
        "summary": "Download Logs",
        "responses": {
          "200": {
            "content": {"text/plain": {"schema": {"type": "string"}}}
          }
        }
      }
    }
  }
}